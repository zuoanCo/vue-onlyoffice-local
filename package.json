{
  "name": "@zzk-1015/vue-onlyoffice-local",
  "version": "2.0.1",
  "description": "A Vue 3 plugin for fully local OnlyOffice editing: DOCX/XLSX/PPTX open as Blob URLs with no uploads and no document server. Live demo: https://onlyoffice.zkhi.top",
  "main": "./dist/vue-onlyoffice-local.umd.js",
  "module": "./dist/vue-onlyoffice-local.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-onlyoffice-local.mjs",
      "require": "./dist/vue-onlyoffice-local.umd.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README_CN.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest",
    "preview": "vite preview",
    "dev:playground": "vite dev --config vite.config.playground.ts",
    "dev:demo": "vite dev --config vite.config.demo.ts",
    "self-test": "node tests/integration/self-test.mjs",
    "build:demo": "vite build --config vite.config.demo.ts",
    "preview:demo": "vite preview --config vite.config.demo.ts"
  },
  "keywords": [
    "vue",
    "vue3",
    "onlyoffice",
    "local",
    "wasm",
    "editor"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zuoanCo/vue-onlyoffice-local.git"
  },
  "bugs": {
    "url": "https://github.com/zuoanCo/vue-onlyoffice-local/issues"
  },
  "homepage": "https://onlyoffice.zkhi.top",
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.10",
    "@vitejs/plugin-vue": "^4.0.0",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^27.4.0",
    "playwright-core": "^1.63.0",
    "typescript": "^5.0.0",
    "vite": "^4.0.0",
    "vite-plugin-dts": "^2.0.0",
    "vitest": "^4.0.18",
    "vue": "^3.2.0",
    "vue-tsc": "^3.2.4"
  }
}
